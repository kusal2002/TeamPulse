        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% USERS &amp; ROLES\n    USER {\n        string id PK\n        string email UK\n        string passwordHash\n        string name\n        enum role \&quot;TEAM_MEMBER, MANAGER\&quot;\n        datetime createdAt\n    }\n\n    %% PROJECTS\n    PROJECT {\n        string id PK\n        string name UK\n        string description\n        datetime createdAt\n    }\n\n    %% REPORTS (The Concept)\n    REPORT {\n        string id PK\n        string userId FK\n        string projectId FK\n        datetime weekStart\n        enum status \&quot;DRAFT, SUBMITTED, NEEDS_CORRECTION, APPROVED\&quot;\n        datetime createdAt\n    }\n\n    %% REPORT VERSIONS (The Actual Data)\n    REPORT_VERSION {\n        string id PK\n        string reportId FK\n        int versionNumber\n        datetime submittedAt\n        string tasksPlannedNext\n        string optionalNotes\n    }\n\n    %% FIXED STRUCTURE TABLES\n    TASK_COMPLETED {\n        string id PK\n        string reportVersionId FK\n        string taskName\n        string priority\n        int plannedPercent\n        int actualPercent\n        string status\n        float timePlanned\n        float timeSpent\n        string deliverable\n    }\n\n    BLOCKER {\n        string id PK\n        string reportVersionId FK\n        string description\n        boolean isKeyIssue\n    }\n\n    ACHIEVEMENT {\n        string id PK\n        string reportVersionId FK\n        string description\n        boolean isKeyHighlight\n    }\n\n    HOURS_WORKED {\n        string id PK\n        string reportVersionId FK\n        string taskType\n        float hours\n    }\n\n    %% REVIEW WORKFLOW\n    REVIEW_COMMENT {\n        string id PK\n        string reportId FK\n        string reportVersionId FK\n        string managerId FK\n        string comment\n        enum action \&quot;APPROVED, REQUESTED_CHANGES\&quot;\n        datetime createdAt\n    }\n\n    %% RELATIONSHIPS\n    USER ||--o{ REPORT : \&quot;creates\&quot;\n    USER }o--o{ PROJECT : \&quot;assigned to / manages\&quot;\n    PROJECT ||--o{ REPORT : \&quot;categorizes\&quot;\n    \n    REPORT ||--|{ REPORT_VERSION : \&quot;has versions of\&quot;\n    REPORT ||--o{ REVIEW_COMMENT : \&quot;receives\&quot;\n    \n    REPORT_VERSION ||--o{ TASK_COMPLETED : \&quot;contains\&quot;\n    REPORT_VERSION ||--o{ BLOCKER : \&quot;contains\&quot;\n    REPORT_VERSION ||--o{ ACHIEVEMENT : \&quot;contains\&quot;\n    REPORT_VERSION ||--o{ HOURS_WORKED : \&quot;contains\&quot;\n    REPORT_VERSION ||--o{ REVIEW_COMMENT : \&quot;reviewed via\&quot;\n    \n    USER ||--o{ REVIEW_COMMENT : \&quot;writes as manager\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="U4EJgswhcpOFUJ_JFnL0-265">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
